{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-configure",
      "type": "shell",
      "command": "cmake -S . -B build",
      "problemMatcher": []
    },
    {
      // -j20 고정. 호스트가 18 코어라 그걸 덮는 값이면 충분하고, OS 별로 코어 수를
      //   세는 분기가 없어서 Windows 와 명령이 같아진다.
      //   숫자 없는 -j 는 "준비된 타깃 전부" 라서 쓰지 않는다 (10-dev-environment.md 3절).
      // configure 는 dependsOn 으로 분리한다. && 는 PowerShell 5.1 에서 안 통한다.
      "label": "build-build",
      "type": "shell",
      "command": "cmake --build build -j20",
      "dependsOn": "build-configure",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "build-clean",
      "type": "shell",
      "command": "cmake --build build --target clean",
      "problemMatcher": []
    },
    {
      // macOS / Linux 전용. Windows 에서는 cortex-debug 런치 구성으로 적재한다.
      "label": "load-sram",
      "type": "shell",
      "command": "./tools/load.sh",
      "problemMatcher": [],
      "dependsOn": "build-build"
    },
    {
      // 서명 → 외부 로더로 외부 NOR 기록 → 리셋 (docs/26-flash-boot.md)
      //   Flash boot / Development boot 모두에서 돌고 있는 FSBL 위에 쓴다.
      "label": "flash-ext",
      "type": "shell",
      "command": "python3 tools/flash.py",
      "windows": { "command": "python tools/flash.py" },
      "problemMatcher": [],
      "dependsOn": "build-build"
    },
    {
      // UART(ST-LINK VCP) 로 FSBL 업데이트 (docs/28-uart-download.md). 디버거 없이 CLI 포트로 보낸다.
      //   포트는 ST-LINK VCP 를 자동으로 찾는다. 빌드는 하지 않는다 (build-build 를 먼저 돌린다).
      "label": "download-uart",
      "type": "shell",
      "command": "python3 tools/download.py",
      "windows": { "command": "python tools/download.py" },
      "problemMatcher": []
    },
    {
      // 포트를 직접 고른다 — 보드가 여러 대일 때 (Firmware Task Manager 확장이 목록을 띄운다)
      "label": "download-uart (포트 선택)",
      "type": "shell",
      "command": "python3 tools/download.py --port ${input:uartPort}",
      "windows": { "command": "python tools/download.py --port ${input:uartPort}" },
      "problemMatcher": []
    }
  ],
  // 포트 선택은 Firmware Task Manager 확장(baram-dev.firmware-task-manager)이 채운다.
  // 확장 없이 실행하면 VS Code 가 입력창을 띄운다. auto 로 두면 자동 탐색한다.
  "inputs": [
    {
      "id": "uartPort",
      "type": "command",
      "command": "firmware-task.pickSerialPort",
      "args": {
        "placeholder": "ST-LINK VCP (CLI 포트) 를 고른다",
        "filter": "usbmodem|ttyACM|COM"
      }
    }
  ]
}
