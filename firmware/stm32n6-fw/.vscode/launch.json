{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FSBL (SRAM)",
      "cwd": "${workspaceRoot}",
      "executable": "./build/stm32n6-fw.elf",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "stlink",
      "showDevDebugOutput": "none",
      "serverArgs": ["-m", "1"],
      "runToEntryPoint": "main",
      "osx": {
        // CubeCLT 는 pkg 를 설치하지 않고 필요한 것만 ~/ST 에 추출해 두고,
        // 버전 없는 링크로 참조한다. (10-dev-environment.md 4절)
        //   ln -sfn ~/ST/STM32CubeCLT_<버전> ~/ST/STM32CubeCLT
        // gdbserver 는 구형 ST-LINK 펌웨어를 거부한다 -> STLinkUpgrade.sh
        "serverpath": "${userHome}/ST/STM32CubeCLT/STLink-gdb-server/bin/ST-LINK_gdbserver",
        "stm32cubeprogrammer": "${userHome}/ST/STM32CubeCLT/STM32CubeProgrammer/bin",
        "svdFile": "${userHome}/ST/STM32CubeCLT/STMicroelectronics_CMSIS_SVD/STM32N657.svd"
      },
      // FSBL 은 BootROM 이 0x34180400 에 적재해 실행하는 이미지다.
      // 하드웨어 리셋으로 진입하는 것이 아니므로, load 후 벡터테이블에서
      // SP/PC 를 직접 세팅한다.
      "postLaunchCommands": [
        "set $sp = *(unsigned int*)0x34180400",
        "set $pc = *(unsigned int*)0x34180404"
      ],
      "overrideLaunchCommands": [
        "load"
      ]
    }
  ]
}
